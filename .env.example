# Copy to .env and fill in locally. Never commit .env.
# Placeholders only — no real values belong in this file.
# Stage 1: the application does not read any of these yet.

# EIA Open Data API key, for the planned EIA connector (DATA-01).
# Request a free key from EIA; keep it only in your local .env.
EIA_API_KEY=

# Local paths (outside the repo, or under the gitignored data/ directory)
DATA_DIR=./data
CACHE_DIR=./data/cache

# Logging
LOG_LEVEL=INFO
