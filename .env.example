# Copy to .env (gitignored) and fill in locally. Never commit .env.
# Placeholders only — no real values belong in this file.
# The mambo CLI loads ./.env for the two keys below. It never overrides variables
# already set in the environment, and it refuses a .env that git does not ignore.

# EIA Open Data API key, used only by `mambo collect` and `mambo sources --remote`.
# Request a free key at https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# Observation store location. Default: ./data (gitignored). Must be outside the
# repository or under its data/ directory; publication-style paths are rejected.
MAMBO_DATA_DIR=./data
